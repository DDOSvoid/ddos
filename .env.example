# Tushare API（初始化股票列表用）
TUSHARE_TOKEN=your_tushare_token_here

# DeepSeek API — 字段提取 + 深度分析
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 说明：
# - 模型名（deepseek-v4-flash）和思考模式（disabled）在 config/config.yaml 的 models.extraction / models.analysis 配置，不在此处改。
# - 数据库地址（database.url）、日志级别（logging.level）也在 config/config.yaml 配置。
